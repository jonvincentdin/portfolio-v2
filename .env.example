# Database
# Set to seed for a read-only preview without database access; leave blank for CMS.
PORTFOLIO_CONTENT_SOURCE=
DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

# Owner authentication
OWNER_EMAIL=owner@example.com
AUTH_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_...
AUTH_FROM_EMAIL=Portfolio <onboarding@resend.dev>
